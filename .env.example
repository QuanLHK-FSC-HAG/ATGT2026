# SafeRide EDU AI — Mẫu biến môi trường (KHÔNG điền secret giả thành thật, KHÔNG commit .env*)
NEXT_PUBLIC_APP_URL=

# Chế độ nghiệm thu local tuyệt đối không gọi Google/Gemini. Khởi chạy bằng:
# npm run dev:acceptance (đặt biến này nội bộ; không dùng cho production).
# SAFERIDE_LOCAL_ACCEPTANCE=true
# SAFERIDE_FORCE_LOCAL_MOCK=true
# SAFERIDE_LOCAL_MOCK_FILE=.runtime/local-acceptance/logical_store.json

# Google OAuth cho Admin Sign-In
# Tạo "OAuth client ID" loại Web application tại Google Cloud Console.
# Authorized JavaScript origins: http://localhost:3000, http://127.0.0.1:3000 và domain triển khai.
# Authorized redirect URIs: không bắt buộc với Google Identity Services (ID Token flow).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ADMIN_ALLOWLIST=
# BẮT BUỘC trên production/Vercel: chuỗi ngẫu nhiên >= 32 ký tự.
# Thiếu biến này, đăng nhập admin sẽ fail-closed thay vì tạo phiên không xác minh được.
ADMIN_SESSION_SECRET=
# Chỉ dùng khi chạy local: cho phép đăng nhập nhanh bằng email trong allowlist.
# Đặt false để tắt hoàn toàn (mặc định đã tắt trên production).
ALLOW_LOCAL_ADMIN_LOGIN=true

# (Tùy chọn) Nếu muốn nhúng Client ID từ lúc build thay vì đọc qua /api/auth/admin/config
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Google Sheets & Drive (do Admin sở hữu/quản lý)
GOOGLE_SHEETS_ID=
GOOGLE_DRIVE_FOLDER_ID=
# Chọn một cơ chế kết nối Google đã xác minh:
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
# hoặc Google OAuth server-side theo thiết kế đã duyệt; không cần cả hai nếu không dùng.

# Gemini Server-side API (không dùng tiền tố NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=

# Bảo mật phiên học sinh & cấu hình batch log
PARTICIPANT_SESSION_SECRET=
LOG_BATCH_MAX_EVENTS=50
LOG_BATCH_MAX_BYTES=131072
